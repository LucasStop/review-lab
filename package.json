{
  "name": "review-lab",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "axios": "^1.20.0",
    "domhandler": "^6.0.1",
    "expo": "~58.0.16",
    "expo-crypto": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "htmlparser2": "^12.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^22",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:ui": "jest",
    "test:contract": "node --test scripts/contract.test.ts"
  },
  "private": true,
  "packageManager": "yarn@1.22.22",
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "testMatch": [
      "**/*.test.tsx"
    ]
  }
}
